# Public address. Create the subdomain at https://www.duckdns.org first.
APP_DOMAIN=your-name.duckdns.org
TLS_EMAIL=you@example.com
DUCKDNS_SUBDOMAIN=your-name
DUCKDNS_TOKEN=replace-with-your-duckdns-token

# PostgreSQL runs privately inside the deployment.
DB_NAME=lotus_funds
DB_USER=lotus_user
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Application security. Use at least 64 random characters.
JWT_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_VALUE
PASSWORD_SETUP_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=1
REGISTRATION_TOKEN_TTL_HOURS=24

# Public checkout key and private Razorpay credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CHECKOUT_NAME=Lotus Funds
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_OLD_SECRET=
CLIENT_RA_SUBSCRIPTION_PRICE_PAISE=249900
CLIENT_RA_SUBSCRIPTION_DURATION_DAYS=365

# Email. Gmail requires an App Password, not the normal account password.
EMAIL_ENABLED=false
EMAIL_PROVIDER=gmail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Lotus Funds
EMAIL_FROM_ADDRESS=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Use a Meta System User token rather than the 24-hour test token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

ENABLE_SUBSCRIPTION_EXPIRY_WORKER=true
SUBSCRIPTION_EXPIRY_INTERVAL_MINUTES=60
SUBSCRIPTION_RENEWAL_WINDOW_DAYS=30

SWAGGER_ENABLED=false
DHAN_INSTRUMENT_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master.csv
